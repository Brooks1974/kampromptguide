---
import type { Prompt } from '../data/prompts';

interface Props {
  prompt: Prompt;
}

const { prompt } = Astro.props;
---

<article class="card prompt-card" id={prompt.slug}>
  <header>
    <span class="tag">{prompt.tag}</span>
    <h3>{prompt.title}</h3>
    <p class="when">{prompt.when}</p>
  </header>

  {prompt.steps ? (
    <div>
      <p class="step-note">Run these as three separate turns, not one paste.</p>
      <div class="steps">
        {prompt.steps.map((step, index) => {
          const stepId = `${prompt.slug}-step-${index + 1}`;
          return (
            <div class="step">
              <div class="step-head">
                <span class="step-label">{step.label}</span>
                <button type="button" class="copy-btn" data-copy-target={stepId}>
                  Copy
                </button>
              </div>
              <pre id={stepId}><code>{step.text}</code></pre>
            </div>
          );
        })}
      </div>
    </div>
  ) : (
    <>
      <div class="prompt-body">
        <pre id={prompt.slug + '-text'}><code>{prompt.text}</code></pre>
      </div>
      <div class="prompt-actions">
        <button type="button" class="copy-btn" data-copy-target={prompt.slug + '-text'}>
          Copy
        </button>
      </div>
    </>
  )}
</article>
