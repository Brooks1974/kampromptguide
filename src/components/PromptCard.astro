---
import type { Prompt } from '../data/prompts';

interface Props {
  prompt: Prompt;
}

const { prompt } = Astro.props;
---

<article class="prompt-card" id={prompt.slug}>
  {prompt.steps ? (
    <>
      <div class="prompt-head">
        <h3>{prompt.title}</h3>
      </div>
      <p class="when">{prompt.when}</p>
      <p class="step-note">Three turns. Copy each one separately.</p>
      <div class="steps">
        {prompt.steps.map((step, index) => {
          const stepId = `${prompt.slug}-step-${index + 1}`;
          return (
            <div class="step">
              <div class="step-head">
                <span class="step-label">{step.label}</span>
                <button type="button" class="copy-btn" data-copy-target={stepId}>
                  Copy
                </button>
              </div>
              <div class="prompt-text" id={stepId}>{step.text}</div>
            </div>
          );
        })}
      </div>
    </>
  ) : (
    <>
      <div class="prompt-head">
        <h3>{prompt.title}</h3>
        <button type="button" class="copy-btn" data-copy-target={`${prompt.slug}-text`}>
          Copy
        </button>
      </div>
      <p class="when">{prompt.when}</p>
      <div class="prompt-text" id={`${prompt.slug}-text`}>{prompt.text}</div>
    </>
  )}
</article>
