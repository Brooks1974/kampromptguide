---
import '@fontsource/inter/400.css';
import '@fontsource/inter/400-italic.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { OG_IMAGE, SITE_NAME, organizationLd, pageUrl } from '../lib/site';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
}

const { title, description, jsonLd = [] } = Astro.props;
const canonical = pageUrl(Astro.url.pathname);
const graph = [organizationLd, ...jsonLd];
const structured = {
  '@context': 'https://schema.org',
  '@graph': graph,
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#042a5d" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={OG_IMAGE} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      (function () {
        var host = location.hostname;
        if (host === 'kampromptguide.com' || host === 'www.kampromptguide.com') return;
        if (/\.netlify\.app$/.test(host)) {
          var existing = document.querySelector('meta[name="robots"]');
          if (existing) existing.setAttribute('content', 'noindex,nofollow');
        }
      })();
    </script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structured)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import { bindCopy } from '../scripts/copy-assemble';
      bindCopy(document);
    </script>
  </body>
</html>
